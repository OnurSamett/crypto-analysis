# OKX DEMO trading API anahtarları (okx.com → Demo Trading → API).
# Gerçek hesap anahtarı KOYMAYIN: istemci yalnızca demo modunda çalışır.
# Anahtara sadece "Okuma" + "İşlem" yetkisi verin, "Çekim" yetkisi VERMEYİN.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# Telegram bildirimleri (notify komutu). Bot: Telegram'da @BotFather → /newbot. Token'ı BURAYA yazın, sohbete veya repoya değil.
# Sohbet kimliği için: bota /start yazın, sonra `python3 -m okx_karar notify --get-chat-id` çalıştırın.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

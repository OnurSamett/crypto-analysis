<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.onursamett.crypto-analysis.collect</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PY__</string>
    <string>-m</string>
    <string>okx_karar</string>
    <string>collect</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <!-- 5 dakikada bir anlık görüntü (funding, açık pozisyon, defter derinliği, oranlar). -->
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__LOGS__/collect.log</string>
  <key>StandardErrorPath</key><string>__LOGS__/collect.err.log</string>
</dict>
</plist>
